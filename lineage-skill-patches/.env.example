# lineagE-skill .env.example
# 复制到 ~/.minimax/skills/lineage-skill/.env 并填入真实值

# Stage 3 蒸馏用的 LLM (本草先生用 deepseek-v4-flash 关 thinking)
LINEAGE_TEXT_API_KEY=sk-your-deepseek-api-key-here
LINEAGE_TEXT_BASE_URL=https://api.deepseek.com/v1
LINEAGE_TEXT_MODEL=deepseek-v4-flash
LINEAGE_TEXT_MAX_TOKENS=4096
LINEAGE_TEXT_TIMEOUT=300

# (可选) 备选模型:逗号分隔,失败时自动 fallback
# LINEAGE_TEXT_MODEL=deepseek-v4-flash,deepseek-chat

# 视觉模型(本草先生不用,但 lineage-skill 需要)
LINEAGE_VISION_API_KEY=sk-your-vision-api-key
LINEAGE_VISION_BASE_URL=https://api.openai.com/v1
LINEAGE_VISION_MODEL=gpt-4o
LINEAGE_VISION_TIMEOUT=600
